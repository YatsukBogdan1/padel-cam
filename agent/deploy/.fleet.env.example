# Shared config for setup-pi.sh, used for every Pi. Copy to .fleet.env (gitignored).

# Tailscale reusable auth key — Pre-approved, Reusable, tagged tag:padel-cam.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Your deployed Worker URL (no trailing slash).
BACKEND=https://padel-worker.YOUR-SUBDOMAIN.workers.dev

# Must match the Worker's DEVICE_TOKEN secret. Leave blank while auth is off.
DEVICE_TOKEN=

# Default multipart part size (MiB).
PART_SIZE_MB=5

# Leave BLANK normally. Raspberry Pi OS auto-detects the IMX477 HQ camera and the
# v2/v3 modules, and provision-pi.sh makes sure camera_auto_detect=1 is set. Only
# fill this in when auto-detection fails (long ribbon cables, some HQ revisions):
# it pins the sensor with dtoverlay=<value> and needs a reboot to take effect.
#   CAMERA_OVERLAY=imx477
CAMERA_OVERLAY=

# --- flash-card.sh only ------------------------------------------------------
# Used when writing a blank SD card. Passphrases are NEVER stored here — the
# script prompts for each one and they are only ever written to the card.

# Account created on the Pi at first boot. setup-pi.sh then uses it over SSH.
PI_USER=pi

# WiFi regulatory domain, two-letter code for where the Pi will RUN (the venue,
# not your home). Without this, 5 GHz channels stay invisible to the Pi.
WIFI_COUNTRY=PT

# QUOTE any SSID containing a space or apostrophe — this file is sourced by bash,
# and an unquoted value silently becomes EMPTY, which skips that network entirely:
#     HOTSPOT_SSID="Sam's iPhone"        correct
#     HOTSPOT_SSID=Sam's iPhone          broken, and quietly so

# Your home network — how the Pi comes up on the bench for provisioning.
HOME_SSID=

# The venue's networks, baked in at flash time. This is what lets the Pi join the
# court WiFi unaided on its first boot there, with no cable, tether or monitor.
VENUE_SSID_5G=
VENUE_SSID_24=

# Your phone hotspot, saved at the lowest priority as permanent recovery: if the
# venue changes its WiFi, turn the hotspot on and the Pi comes back to you.
HOTSPOT_SSID=
