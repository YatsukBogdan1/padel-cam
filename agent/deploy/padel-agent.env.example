# Copy to padel-agent.env and edit. Loaded by the systemd service.

# Unique per court.
COURT_ID=court-1

# Your deployed Worker URL (from `wrangler deploy`). No trailing slash.
BACKEND=https://padel-worker.YOUR-SUBDOMAIN.workers.dev

# Must match the Worker's DEVICE_TOKEN secret. Leave blank only while testing with auth off.
DEVICE_TOKEN=

# Multipart part size (MiB). 5 is the R2 minimum; larger = fewer requests, more RAM/latency.
# R2 also requires every part EXCEPT THE LAST to be exactly this size, and only
# checks at complete time -- so this must not change mid-recording.
PART_SIZE_MB=5

# Where captured video waits for upload. Capture writes here first and always,
# so a slow or dead network defers footage instead of losing it. Set by
# provision-pi.sh; override only if you spool to a USB SSD instead of the card.
SPOOL_DIR=/var/lib/padel-agent/spool

# Share of FREE disk one recording may consume. At 80% of this the agent warns by
# email; at 95% it seals the recording early -- the file stays valid and playable,
# it just stops short. Filling the filesystem instead would take journald and sshd
# down with it, turning a network outage into a venue visit.
DISK_BUDGET_PCT=80

# --- CAPTURE_CMD -------------------------------------------------------------
# A shell command that emits a STREAMABLE (fragmented) MP4 to stdout. Pick ONE line
# below for your hardware, then validate the camera first:
#   CSI module:  rpicam-hello --list-cameras     (your sensor must be listed)
#   USB webcam:  v4l2-ctl --list-formats-ext -d /dev/video0
#                (or run agent/deploy/usb-camera-bench.sh, which checks every node)
#
# IMPORTANT: the value MUST be wrapped in double quotes — it contains spaces and a
# pipe, and unquoted it won't load correctly.
#
# HQ camera (IMX477) / Camera Module v2/v3 not detected? Re-run provision-pi.sh with
# an explicit sensor, e.g. `sudo CAMERA_OVERLAY=imx477 ... bash provision-pi.sh`,
# which writes `dtoverlay=imx477` to /boot/firmware/config.txt for you.
#
# The frag flags (frag_keyframe+empty_moov+default_base_moof) are what make the MP4
# playable while it's still being written — do not drop them.

# Pi 4 / Pi 3 / Pi Zero 2 W + CSI camera module (incl. IMX477 HQ — hardware H.264):
CAPTURE_CMD="rpicam-vid -t 0 --nopreview --inline --width 1920 --height 1080 --framerate 30 --codec h264 -o - | ffmpeg -loglevel error -f h264 -r 30 -i - -c copy -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 -"

# Pi 5 + CSI camera module (no hardware H.264 — software encode; consider 1280x720):
# CAPTURE_CMD="rpicam-vid -t 0 --nopreview --width 1920 --height 1080 --framerate 30 --codec yuv420 -o - | ffmpeg -loglevel error -f rawvideo -pix_fmt yuv420p -s 1920x1080 -r 30 -i - -c:v libx264 -preset veryfast -tune zerolatency -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 -"

# ELP USB4KCAM01H-H120 (Sony IMX415, 4K, USB/UVC) -- any Pi, camera encodes H.264:
# The camera does the encoding, the Pi only copies bytes (-c copy), so this line is
# the same on a Pi 4 and a Pi 5 and the CPU stays near idle. Do not hand-write it:
#   agent/deploy/usb-camera-bench.sh   (on the Pi) measures the camera and prints
# this line with the camera's real /dev/v4l/by-id path, and provision-pi.sh selects
# it automatically when the camera is plugged in. Use the by-id path, never
# /dev/videoN: that number moves between boots, especially next to a CSI camera.
#   -an                     the camera has no microphone; never carry audio
#   -frag_duration 2000000  cut a fragment at least every 2 s. With frag_keyframe
#                           alone ffmpeg holds everything since the last keyframe in
#                           RAM, and a UVC camera may send one only every ~10-20 s.
# CAPTURE_CMD="ffmpeg -loglevel error -f v4l2 -input_format h264 -video_size 3840x2160 -framerate 30 -i /dev/v4l/by-id/usb-REPLACE_WITH_BENCH_OUTPUT-video-index0 -c copy -an -frag_duration 2000000 -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 -"

# USB webcam that outputs H.264 natively (no transcode — check with v4l2-ctl):
# CAPTURE_CMD="ffmpeg -loglevel error -f v4l2 -input_format h264 -video_size 1920x1080 -framerate 30 -i /dev/video0 -c copy -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 -"

# USB webcam that outputs MJPEG/raw (transcode to H.264 on CPU):
# CAPTURE_CMD="ffmpeg -loglevel error -f v4l2 -video_size 1280x720 -framerate 30 -i /dev/video0 -c:v libx264 -preset veryfast -tune zerolatency -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 -"
