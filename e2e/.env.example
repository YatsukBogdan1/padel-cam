# Copy to e2e/.env and fill in. Gitignored: it holds an admin password and the
# device token.

# The Worker under test. Use the deployed URL for a real preproduction run, or
# http://127.0.0.1:8787 to point the same suite at `npm run dev`.
BACKEND=https://padel-worker.YOUR-SUBDOMAIN.workers.dev

# The camera. SSH target and the COURT_ID that Pi is configured with.
PI_HOST=pi@court-test-1
COURT_ID=court-test-1

# An admin account at the venue this court belongs to. Super-admin is preferred:
# without it the suite cannot purge the recordings it creates.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Must match the Worker's DEVICE_TOKEN secret. Only needed for scenarios that
# talk to the device surface directly.
DEVICE_TOKEN=

# Where the agent spools on the Pi.
SPOOL_DIR=/var/lib/padel-agent/spool

# Seconds of video per recording scenario. Longer is more realistic and slower.
RECORD_SECONDS=45

# Lowest acceptable ratio of captured duration to wall-clock time. Below 1.0
# means frames are being dropped; `preflight` measures what this board can
# actually sustain, so tune this to the hardware rather than wishing.
MIN_DURATION_RATIO=0.8
